FROM rayproject/ray:2.40.0-py312-gpu

# Install C compiler needed by Triton (runs as root, then switches back)
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN mkdir -p /app/output && chown -R ray:users /app
USER ray

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

COPY --chown=ray:users training/pyproject.toml training/uv.lock ./
ENV UV_LINK_MODE=copy
RUN uv sync --frozen

COPY training/data /app/data
COPY --chown=ray:users training/train_qlora.py /app/train_qlora.py

CMD ["uv", "run", "--frozen", "python", "/app/train_qlora.py"]